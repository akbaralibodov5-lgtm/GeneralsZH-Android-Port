<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GeneralsX @feature Android port launcher-ui-2026 08/09/2026 Design
         tokens for the launcher (Setup / GeneralsOnline / Log Viewer /
         Folder Picker). A Material 3 dark colour-role set: one near-black
         ground, a small ladder of "surface container" greys for cards and
         rows on top of it, a soft lavender primary for headings/active
         state and a muted pastel for destructive actions.

         GeneralsZHActivity (the game surface itself) never references any of
         these — it stays on its own plain fullscreen theme.

         The gzh_primary/gzh_accent/gzh_surface/... names below predate this
         palette and are kept (they are referenced from themes.xml and from
         Java) — only their values were retuned to the new palette. -->

    <!-- Ground + surface ladder (M3 surface container roles) -->
    <color name="gzh_background">#EAF7FF</color>
    <color name="gzh_surface">#F0F9FF</color>
    <color name="gzh_surface_container_low">#EAF6FD</color>
    <color name="gzh_surface_container">#DFF2FC</color>
    <color name="gzh_surface_container_high">#D6EDFA</color>
    <color name="gzh_surface_container_highest">#CBE7F7</color>

    <!-- Content on those surfaces -->
    <color name="gzh_on_surface">#142733</color>
    <color name="gzh_on_surface_variant">#526875</color>
    <!-- The faintest tier still has to clear WCAG AA (4.5:1) at 12sp against
         gzh_surface_container, which #7C798C did not (3.9:1). -->
    <color name="gzh_on_surface_faint">#607887</color>
    <color name="gzh_outline">#C7DCE8</color>
    <color name="gzh_outline_variant">#DCECF5</color>

    <!-- Primary: the soft lavender accent (headings, active nav item,
         selected segment, hero action). -->
    <color name="gzh_primary">#168FCA</color>
    <color name="gzh_on_primary">#FFFFFF</color>
    <color name="gzh_primary_container">#CDEEFF</color>
    <color name="gzh_on_primary_container">#102C3B</color>
    <!-- Kept for the themes.xml colorPrimaryDark slot (pre-API-23 status bar). -->
    <color name="gzh_primary_dark">#EAF7FF</color>
    <color name="gzh_accent">#168FCA</color>

    <!-- Secondary: a desaturated companion for tonal chips/containers. -->
    <color name="gzh_secondary">#D3F0FF</color>
    <color name="gzh_on_secondary">#123144</color>
    <color name="gzh_secondary_container">#D7F0FC</color>
    <color name="gzh_on_secondary_container">#123144</color>

    <!-- Tertiary: the muted pastel used for destructive / "clear" actions. -->
    <color name="gzh_tertiary">#FBE5E2</color>
    <color name="gzh_on_tertiary">#B84F43</color>
    <color name="gzh_tertiary_container">#F8DCD8</color>
    <color name="gzh_on_tertiary_container">#963D34</color>

    <color name="gzh_error">#B84F43</color>
    <color name="gzh_on_error">#FFFFFF</color>
    <color name="gzh_error_container">#F8DCD8</color>
    <color name="gzh_on_error_container">#7A2B24</color>

    <!-- Disabled state (M3: 38% of on-surface for content, 12% for containers) -->
    <color name="gzh_on_surface_disabled">#99526775</color>
    <color name="gzh_container_disabled">#1F168FCA</color>
    <color name="gzh_ripple_light">#1F168FCA</color>
    <color name="gzh_ripple_primary">#33168FCA</color>

    <!-- GeneralsX @feature Android port game-folder-integrity-check 07/09/2026
         Semantic status colours for the game-folder validity line (see
         refreshStatus() in SetupActivity.java) — retuned for the near-black
         ground above so they stay legible without shouting. -->
    <color name="gzh_status_ok">#167A45</color>
    <color name="gzh_status_warn">#946000</color>
    <color name="gzh_status_error">#B84F43</color>
</resources>
