HOST=127.0.0.1
PORT=8787
NODE_ENV=production
ALLOWED_ORIGINS=https://waruevil.uz
# Implement these authenticated server-to-server endpoints in GeneralsOnline first.
AUTH_VERIFY_URL=https://YOUR-GENERALSONLINE-BACKEND.example/api/voice/verify-session
LOBBY_AUTHORIZE_URL=https://YOUR-GENERALSONLINE-BACKEND.example/api/voice/authorize-lobby
BACKEND_SHARED_TOKEN=replace-with-long-random-secret
STUN_URL=stun:YOUR-VOICE-HOST.example:3478
TURN_URL=turn:YOUR-VOICE-HOST.example:3478?transport=udp
TURN_TLS_URL=turns:YOUR-VOICE-HOST.example:5349?transport=tcp
TURN_SHARED_SECRET=replace-with-coturn-static-auth-secret
TURN_CREDENTIAL_TTL_SECONDS=3600
MAX_CONNECTIONS=500
MAX_MESSAGE_BYTES=65536
MAX_MESSAGES_PER_10_SECONDS=80
MAX_PEERS_PER_ROOM=16